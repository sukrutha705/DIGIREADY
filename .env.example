# ==============================================================================
# DigiReady - Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Database Connection (SQLite local file for dev/demo, or hosted database for production)
DATABASE_URL="file:./dev.db"

# Server Configuration
NODE_ENV="development"
PORT="3000"

# Production Deployment Note:
# On Vercel / Cloud platforms, configure DATABASE_URL in the project environment variables.
# The application initializes Prisma lazily, allowing builds to succeed without static prerender failures.

