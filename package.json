{
  "name": "digiready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-db.js && next dev",
    "build": "node scripts/prepare-db.js && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/prepare-db.js && vitest run",
    "test:watch": "node scripts/prepare-db.js && vitest",
    "db:generate": "node scripts/prepare-db.js && prisma generate",
    "db:push": "node scripts/prepare-db.js && prisma db push",
    "db:seed": "node scripts/prepare-db.js && tsx prisma/seed.ts",
    "db:deploy": "node scripts/prepare-db.js && prisma db push && tsx prisma/seed.ts",
    "postinstall": "node scripts/prepare-db.js && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
